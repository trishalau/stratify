DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
FLASK_DEBUG=false

# Generate the session secret with: python -c "import secrets; print(secrets.token_hex(32))"
STRATIFY_SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET
STRATIFY_COOKIE_SECURE=false
# Set true for the single-business public demo; set false to require owner login.
STRATIFY_DEMO_MODE=true
# Exact browser origins for Vercel Production and approved Preview deployments.
# Separate multiple origins with commas; no trailing slash.
STRATIFY_CORS_ORIGINS=https://your-frontend-project.vercel.app
# Maximum Gemini interpretation requests per client per rolling minute window.
AI_RATE_LIMIT_PER_MINUTE=12
# Used only by the optional seed-demo CLI command; demo API requests do not query users.
STRATIFY_DEMO_OWNER_USERNAME=LOCAL_ONLY_OWNER

# Gemini Developer API (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
