DATABASE_URL=postgresql+psycopg://stratify:local-dev-password@localhost:5432/stratify
FLASK_DEBUG=1

# Generate the session secret with: python -c "import secrets; print(secrets.token_hex(32))"
STRATIFY_SESSION_SECRET=replace-with-a-random-secret
STRATIFY_COOKIE_SECURE=false
# Set true for the single-business public demo; set false to require owner login.
STRATIFY_DEMO_MODE=true
# Used only by the optional seed-demo CLI command; demo API requests do not query users.
STRATIFY_DEMO_OWNER_USERNAME=owner

# Gemini Developer API (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
